dist/
dist-ssr/

# Logs
logs/
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea/
*.suo
*.sw?
.claude/

# Build artifacts
*.aab
*.apk

# Uploaded user content (runtime, not source)
backend/uploads/

# Account data snapshots — contain password hashes + personal data, never commit.
backend/backups/

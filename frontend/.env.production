# Production build env — used by BOTH the Vercel web build AND the Capacitor
# Android build (`npm run cap:sync` runs `vite build`, which reads this file).
#
# These point at the Render backend (REST + Socket.IO). The Vercel build reads
# this committed file automatically, so no dashboard env config is needed.
VITE_API_URL=https://manithub-backend.onrender.com
VITE_SOCKET_URL=https://manithub-backend.onrender.com

# Push notifications (FCM) — OFF by default. Native push crashes the Android app
# unless Firebase is fully configured (google-services.json in
# frontend/android/app/ + backend FIREBASE_SERVICE_ACCOUNT). Leave unset/false
# until that's done, then set to "true" and rebuild the APK to enable push.
# VITE_PUSH_ENABLED=true

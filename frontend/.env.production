# Production build env — used by BOTH the Netlify web build AND the Capacitor
# Android build (`npm run cap:sync` runs `vite build`, which reads this file).
#
# Point these at the Render backend once it's deployed: replace the placeholder
# below with your Render URL (e.g. https://manithub-backend.onrender.com).
# Until then, real-time chat on the live site/app will not connect.
VITE_API_URL=https://manit-hub.onrender.com
VITE_SOCKET_URL=https://manit-hub.onrender.com

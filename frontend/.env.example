# --- Manit Hub frontend env ---
# Copy to ".env" and adjust as needed. All keys are optional.

# Explicit backend base URL. If set, the app calls "<VITE_API_URL>/api" directly.
# Leave UNSET for local dev to use the Vite proxy (recommended).
# Example for a local backend:
# VITE_API_URL=http://localhost:5001

# Where `npm run dev` proxies /api to. Defaults to the hosted backend so
# login/signup work out of the box. For a local backend use:
# VITE_PROXY_TARGET=http://localhost:5001
VITE_PROXY_TARGET=https://manit-hub-backend.vercel.app

# Realtime chat server (Socket.IO). Defaults to the hosted backend.
# For a local backend use:
# VITE_SOCKET_URL=http://localhost:5001

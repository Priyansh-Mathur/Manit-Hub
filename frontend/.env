# --- Local development ---
# REST API is left UNSET so requests go through the Vite dev proxy:
#   /api  ->  VITE_PROXY_TARGET (the hosted backend by default, see vite.config.js)
# This avoids CORS entirely during local dev.
#
# To use a LOCAL backend instead, run it on :5001 and uncomment:
# VITE_API_URL=http://localhost:5001
# VITE_PROXY_TARGET=http://localhost:5001

# Realtime chat (Socket.IO). The hosted backend accepts socket connections from
# any origin, so this works from localhost. Point at your local backend if running one.
VITE_SOCKET_URL=https://manit-hub-backend.vercel.app

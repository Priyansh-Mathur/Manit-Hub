# --- Manit Hub backend env ---
# Copy to ".env" and fill in. Required: MONGO_URI, JWT_SECRET.

# MongoDB connection string (MongoDB Atlas recommended).
MONGO_URI=your-mongodb-connection-string

# Secret used to sign JWTs — use a long random string.
JWT_SECRET=replace-with-a-long-random-secret

# How long a login stays valid. Long by design so users aren't logged out
# repeatedly — they stay signed in until they explicitly log out. Defaults to
# "365d" if unset. Accepts zeit/ms strings like "30d", "365d", "730d".
JWT_EXPIRE=365d

# Allowed frontend origin(s) for CORS — comma-separated for multiple.
# localhost dev origins and this project's *.netlify.app / *.vercel.app
# subdomains (hostname must contain "manithub") are always allowed.
# Set this to your exact deployed frontend URL.
CLIENT_URL=https://YOUR-NETLIFY-SITE.netlify.app

# Server port (local dev). Hosts usually inject their own.
PORT=5001

# "development" or "production". Controls the localhost-Mongo guard
# and whether password-reset tokens are returned in responses.
NODE_ENV=development

# Cloudinary (image uploads) — not needed for auth, required for photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging (push notifications) — optional.
# Paste the service-account JSON (raw or base64). Leave empty to disable push;
# in-app notifications work regardless.
FIREBASE_SERVICE_ACCOUNT=

# Outbound email (SMTP) — optional but recommended in production.
# When set: signup requires a 6-digit email verification code, and
# forgot-password emails the reset token (instead of the dev-only response).
# When unset: signup works without verification (as before) and reset tokens
# are returned in the response ONLY when NODE_ENV != production.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<Google App Password> (myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Content moderation ---
# Text filter: extra blocked words (comma-separated) on top of the built-in
# English + Hindi/Hinglish list. Applied to confessions, forum, and listings.
EXTRA_BLOCKED_WORDS=

# Auto-moderation thresholds (defaults shown). Content is hidden after this many
# distinct reports; a user is suspended after this many strikes.
AUTO_HIDE_REPORTS=3
AUTO_BAN_STRIKES=3

# Image moderation — OFF by default (uploads are allowed without checking).
# To enable, set a provider and its key. Rejects explicit imagery before it is
# stored. Providers: "google" (Cloud Vision SafeSearch) or "sightengine".
IMAGE_MODERATION_PROVIDER=
GOOGLE_VISION_API_KEY=
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
